# ─────────────────────────────────────────────────────────
#  EduAudit AI — Backend Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# ── LLM Configuration ──────────────────────────────────────
# OpenAI API key (required)
OPENAI_API_KEY=sk-...

# Model to use. Options:
#   gpt-4o          — best quality, slower, higher cost
#   gpt-4o-mini     — recommended for POC (fast, cheap)
#   gpt-3.5-turbo   — budget option
# For local models (Ollama, LM Studio), set OPENAI_BASE_URL too.
LLM_MODEL=gpt-4o-mini

# Base URL — change this to use local/alternative LLM providers
# OpenAI (default):  https://api.openai.com/v1
# Ollama:            http://localhost:11434/v1
# LM Studio:         http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Application ─────────────────────────────────────────────
APP_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Maximum upload file size in MB
MAX_UPLOAD_SIZE_MB=50
